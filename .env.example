# Copy this file to .env and fill in real values. Never commit .env.

# Cookie header used by the Facebook video downloader scrapers
# (src/social-media/facebook.ts). Obtain a fresh cookie string from
# a logged-in browser session against the relevant third-party site.
FACEBOOK_COOKIE=

# Cookie header used by the Twitter video downloader scrapers
# (src/social-media/twitter.ts). Obtain a fresh cookie string from
# a logged-in browser session against the relevant third-party site.
TWITTER_COOKIE=

# Set to "0" in production/public deployments so clients only get a
# generic error message instead of full internal error details.
# (web/server.ts)
EXPOSE_ERROR_DETAILS=0
