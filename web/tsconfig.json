{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es2019",
    "outDir": "../lib/web",
    "baseUrl": "./",
    "rootDir": "../",
    "declaration": false,
    "noEmit": false
  },
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true
    }
  }
}
